# =============================================================================
#  NeteaseMusic (BB10) —— git 忽略规则
# =============================================================================

# -----------------------------------------------------------------------------
#  构建产物：四个配置各占一个目录，里面全是 qmake 生成的 Makefile + .o + 产物
#
#    Device-Debug     arm/o.le-v7-g/
#    Device-Release   arm/o.le-v7/      （qmake 还会再套一层 arm/o.le-v7/o.le-v7/）
#    Device-Profile   arm-p/o.le-v7-g/
#    Simulator-Debug  x86/o-g/
#
#  ★ 别误伤两个同名的「源码」：
#      /Makefile        项目自己的构建入口，要提交
#      /build/          里面是 fix-destdir.ps1、fix-release-artifact.ps1 这类
#                       构建脚本，要提交
#    所以下面都写成【带前导斜杠的顶层路径】，只匹配根目录那一个。
# -----------------------------------------------------------------------------
/arm/
/arm-p/
/x86/

# -----------------------------------------------------------------------------
#  打包 / 签名产物
#    .bar  打出来的安装包（签过名的常见 *.signed.bar 也被 *.bar 覆盖）
#    .csk / .db  签名密钥库（进仓库等于泄露签名身份，务必忽略）
#    .p12  开发者证书
# -----------------------------------------------------------------------------
*.bar
*.csk
*.db
*.p12

# -----------------------------------------------------------------------------
#  编辑器 / 系统杂项
# -----------------------------------------------------------------------------
.vscode/
*~
*.swp
*.autosave
.DS_Store
Thumbs.db
